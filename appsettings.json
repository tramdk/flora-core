{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "SqlServer",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=blogs;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "FloraCore",
    "Audience": "FloraCoreUsers",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "FileStorage": {
    "UploadFolder": "uploads"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "MailSettings": {
    "Server": "",
    "Port": 587,
    "SenderName": "",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/v1/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/v1/auth/register",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "post:/api/v1/auth/refresh",
        "Period": "1m",
        "Limit": 10
      }
    ],
    "IpWhitelist": [
      "127.0.0.1",
      "::1"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Telemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ExportToConsole": false
  },
  "AngularApp": {
    "Url": "http://localhost:4200"
  },
  "ReactApp": {
    "Url": "http://localhost:3000"
  },
  "FanpageAiManagerSettings": {
    "BaseUrl": "http://localhost:3000/api/external",
    "ApiKey": ""
  },
  "AllowedOrigins": "https://tiemhoachinchin.vercel.app",
  "PaymentGateways": {
    "ApiUrl": "",
    "FrontendUrl": "",
    "VnPay": {
      "Url": "",
      "TmnCode": "",
      "HashSecret": ""
    },
    "MoMo": {
      "Url": "",
      "PartnerCode": "",
      "AccessKey": "",
      "SecretKey": "",
      "IpnUrl": ""
    },
    "PayOS": {
      "Url": "",
      "ClientId": "",
      "ApiKey": "",
      "ChecksumKey": ""
    }
  }
}